{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "dist",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "useDefineForClassFields": false
  },
  "include": [
    "src/**/*.ts",
    "../shared/**/*.ts",
    "../src/navigation.ts",
    "../src/animation.ts"
  ]
}